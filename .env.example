# Your exact application origin. Use HTTPS for the deployed site.
APP_URL=http://localhost:3000

# Clerk: create an application with verified email sign-up/sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/billing
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/billing

# Stripe: start with test credentials. Never use NEXT_PUBLIC_ for this key.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook, from this environment's Stripe endpoint.
STRIPE_WEBHOOK_SECRET=
# Active billing portal configuration with cancellation enabled (bpc_...).
STRIPE_PORTAL_CONFIGURATION_ID=

# Server-only custom proposals. Run `npm run offer` to add one to .env.local.
# Copy this full value to your hosting environment, then redeploy.
FRAM_FORGE_OFFERS=[]
